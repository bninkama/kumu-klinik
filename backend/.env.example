# --- Vertex AI + ADC (org policy: no API keys) ---
# On Cloud Run, ADC is the attached service account automatically.
# Locally: run `gcloud auth application-default login`, then set:
GCP_PROJECT=project-d0306dc0-8de8-4965-893
GCP_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# --- Weather (optional; falls back to demo data if missing) ---
OPENWEATHER_API_KEY=

# --- Force demo mode (returns canned diagnosis without calling Vertex AI) ---
DEMO_MODE=false

PORT=8080
