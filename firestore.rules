rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Disease library + market prices: world-readable, write only from backend.
    match /diseases/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /market_prices/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /weather_cache/{id} {
      allow read: if true;
      allow write: if false;
    }
    // Diagnosis history: anyone can add a record (anonymous auth MVP),
    // nobody can list/read all records from the client.
    match /diagnoses_history/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
